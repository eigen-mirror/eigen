{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_style.py\" --claude-hook"
          },
          {
            "type": "command",
            "asyncRewake": true,
            "timeout": 300,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/clang_tidy_hook.py\" --claude-hook"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_style.py\" --claude-hook"
          },
          {
            "type": "command",
            "if": "Bash(git *)",
            "asyncRewake": true,
            "timeout": 300,
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/clang_tidy_hook.py\" --claude-hook"
          }
        ]
      }
    ]
  }
}
